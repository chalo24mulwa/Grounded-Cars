# ==============================================================================
# ENVIRONMENT VARIABLES — TEMPLATE ONLY
#
# Copy this file to .env (local dev) and set real values there.
# .env is git-ignored. NEVER commit real secrets to version control.
# In production, set these via your hosting platform's secret manager /
# environment configuration panel — never via a committed file.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@host:5432/car_marketplace?schema=public&pgbouncer=true"

# Direct (non-pooled) connection string — used only by `prisma migrate`.
# If your provider doesn't require a separate pooler, this can equal DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/car_marketplace?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_URL="http://localhost:3000"

# --- Google Sign-In (OAuth) --------------------------------------------------
# Leave both blank to keep email/password as the only sign-in method — the
# "Continue with Google" button still renders, but a click resolves to a
# clear "not available yet" error instead of crashing (src/lib/auth.ts).
# These exact names are load-bearing: Auth.js's Google provider auto-reads
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET by convention, so no code reads them
# directly — renaming these vars silently breaks Google sign-in.
#
# From the Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID > Web application), set the Authorized redirect URI to:
#   Development:  http://localhost:3000/api/auth/callback/google
#   Production:   https://<your-production-domain>/api/auth/callback/google
# (must match AUTH_URL below — Auth.js derives the callback path from it)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Object Storage (Phase 3) ----------------------------------------------
# Populate once a provider (R2 / B2 / S3) is chosen. Left blank for Phase 1.
STORAGE_PROVIDER="" # e.g. "r2" | "b2" | "s3"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_BASE_URL=""

# --- Payments — M-Pesa Daraja STK Push (centralized) -------------------------
# ONE shared Till/passkey pair for the entire site — every payment surface
# (Featured/Preferred Listings, CSR donations, Car Insurance, and the
# orderable Services: Car Tracking, Pre-Purchase Inspection, etc.) goes
# through this same configuration. There is no per-feature Till anywhere in
# the codebase — src/lib/mpesa.ts is the one centralized place these are
# read from, and every service module downstream (featured-service.ts,
# csr-service.ts, insurance-service.ts, service-catalog-service.ts) just
# calls initiateStkPush() with no Till of its own. What distinguishes one
# payment from another is never the Till — it's which table the
# transaction row lands in (PaymentTransaction, CsrDonation, ServiceOrder,
# InsurancePurchase), each recording its own service reference, customer
# details, amount, and M-Pesa reference/status.
#
# Leave all blank until the business Till number is available — the app
# detects an unconfigured provider and shows a clear "not available yet"
# message on every payment flow instead of crashing (see src/lib/mpesa.ts:
# isMpesaConfigured()); dev/staging can still exercise each flow end to end
# via its own [DEV] simulate buttons.
MPESA_ENV="sandbox" # "sandbox" | "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# Till number (Buy Goods) — NOT a Paybill shortcode. TransactionType is
# fixed to CustomerBuyGoodsOnline in mpesa.ts to match. Shared by every
# payment flow on the site — see the block comment above.
MPESA_TILL_NUMBER=""
MPESA_PASSKEY=""
# Random secret appended as a query param to the callback URL Safaricom is
# given (Daraja callbacks carry no signature/custom headers, so this is the
# practical way to keep the endpoint from being spammed by strangers).
# Generate with: openssl rand -hex 24
MPESA_CALLBACK_SECRET=""

# --- Scheduled jobs (Phase 4) -------------------------------------------------
# Bearer token for POST /api/cron/expiry — a redundant EXTERNAL trigger for
# the subscription-expiry / stale-sold-listing sweep. The app also runs this
# sweep itself on an hourly in-process timer (src/instrumentation.ts), so
# this is a safety net, not the only mechanism. Generate with: openssl rand -hex 24
CRON_SECRET=""

# --- Email (Phase 8) ---------------------------------------------------------
# Leave EMAIL_PROVIDER unset (or "console") to log emails server-side instead
# of sending them — the same "works today, swap in real delivery later"
# pattern as MPESA above. Set to "resend" plus the two vars below once a
# provider is chosen (see src/lib/email.ts: isEmailConfigured()).
EMAIL_PROVIDER="console" # "console" | "resend"
EMAIL_FROM="" # e.g. "Car Marketplace <notifications@yourdomain.com>"
RESEND_API_KEY=""

# --- App --------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="KES"
